// Freshroots demand planner. Mapping confirmed in Step 0 — see src/config/columnMap.ts.
// Connection URLs live in prisma.config.ts (CLI, DIRECT_URL) and src/lib/db.ts (app, DATABASE_URL).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Master and transactional data (from SAP CSV exports) ----------

model Sku {
  code                   String   @id
  name                   String
  category               String
  isPerishable           Boolean
  standardReorderQty     Int?
  unitOfMeasure          String?
  unitPrice              Decimal? @db.Decimal(12, 2)
  casePack               Int?
  leadTimeWeeks          Float?
  primaryDistributorCode String?

  primaryDistributor Distributor?        @relation("PrimaryDistributor", fields: [primaryDistributorCode], references: [code])
  sales              WeeklySale[]
  inventory          InventorySnapshot[]
  eventFlags         EventFlag[]
  recommendations    Recommendation[]
  exceptions         RecException[]
}

model Distributor {
  code   String  @id
  name   String
  region String
  status String?
  tier   String?

  skus       Sku[]        @relation("PrimaryDistributor")
  sales      WeeklySale[]
  eventFlags EventFlag[]
}

model WeeklySale {
  id              Int      @id @default(autoincrement())
  skuCode         String
  distributorCode String
  weekStart       DateTime @db.Date
  units           Int

  sku         Sku         @relation(fields: [skuCode], references: [code])
  distributor Distributor @relation(fields: [distributorCode], references: [code])

  @@unique([skuCode, distributorCode, weekStart])
  @@index([skuCode, weekStart])
}

model InventorySnapshot {
  id       Int      @id @default(autoincrement())
  skuCode  String
  asOfDate DateTime @db.Date
  location String?
  onHand   Int
  onOrder  Int?

  sku Sku @relation(fields: [skuCode], references: [code])

  @@unique([skuCode, asOfDate])
}

model Festival {
  id        Int      @id @default(autoincrement())
  name      String
  startDate DateTime @db.Date
  endDate   DateTime @db.Date
  region    String?

  @@unique([name, startDate])
}

/// Manual market-event flags (exception E3), entered by Raghav or procurement.
model EventFlag {
  id              Int      @id @default(autoincrement())
  skuCode         String?
  distributorCode String?
  startDate       DateTime @db.Date
  endDate         DateTime @db.Date
  note            String
  createdBy       String
  createdAt       DateTime @default(now())

  sku         Sku?         @relation(fields: [skuCode], references: [code])
  distributor Distributor? @relation(fields: [distributorCode], references: [code])
}

// ---------- Engine output and human decisions ----------

enum RunStatus {
  COMPLETED
  HALTED
}

enum RecFlag {
  STOCKOUT_RISK
  OVERSTOCK
  HIGH_DEMAND
  WATCH
  OK
  EXCEPTION
}

enum RecStatus {
  PENDING
  APPROVED
  OVERRIDDEN
  REJECTED
}

enum ExceptionCode {
  E1
  E2
  E3
  E4
  E5
  E6
  E7
}

enum DecisionAction {
  APPROVE
  OVERRIDE
  REJECT
}

enum CheckResult {
  PROCEED
  HOLD
}

model Run {
  id             Int       @id @default(autoincrement())
  runDate        DateTime  @db.Date
  status         RunStatus
  haltReason     String?
  configSnapshot Json
  totals         Json
  warnings       Json?
  createdAt      DateTime  @default(now())

  recommendations Recommendation[]
  exceptions      RecException[]
}

model Recommendation {
  id                Int       @id @default(autoincrement())
  runId             Int
  skuCode           String
  flag              RecFlag
  avg4              Float
  avg12             Float
  festivalFactor    Float
  demandRate        Float
  inventoryPosition Int
  weeksOfCover      Float
  qty               Int
  orderValue        Decimal?  @db.Decimal(14, 2)
  reason            String
  status            RecStatus @default(PENDING)
  onOrderAvailable  Boolean   @default(false)
  surgeConfirmed    Boolean   @default(false)
  createdAt         DateTime  @default(now())

  run                Run                 @relation(fields: [runId], references: [id], onDelete: Cascade)
  sku                Sku                 @relation(fields: [skuCode], references: [code])
  decisions          Decision[]
  preplacementChecks PreplacementCheck[]

  @@unique([runId, skuCode])
  @@index([runId, flag])
}

model RecException {
  id      Int           @id @default(autoincrement())
  runId   Int
  skuCode String
  code    ExceptionCode
  detail  String

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)
  sku Sku @relation(fields: [skuCode], references: [code])

  @@index([runId, code])
}

model Decision {
  id               Int            @id @default(autoincrement())
  recommendationId Int
  action           DecisionAction
  newQty           Int?
  reasonCode       String
  note             String?
  decidedBy        String
  decidedAt        DateTime       @default(now())

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}

model PreplacementCheck {
  id               Int         @id @default(autoincrement())
  recommendationId Int
  checkedAt        DateTime    @default(now())
  result           CheckResult
  triggers         Json
  ownerDecision    String?
  ownerNote        String?

  recommendation Recommendation @relation(fields: [recommendationId], references: [id], onDelete: Cascade)
}
